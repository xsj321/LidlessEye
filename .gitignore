# Rust
/target
**/*.rs.bk

# Node / frontend
web/node_modules
web/.next
web/out
web/*.tsbuildinfo
# The dashboard export is generated by `make ui` and embedded at compile time;
# `crates/lidlesseye-server/build.rs` mirrors it into the crate's `ui/` folder
# (which is what `cargo package` ships), and keeps an empty placeholder there so
# a checkout without Node still compiles.
web/dist/
crates/lidlesseye-server/ui/

# Local data and binaries
lidlesseye-data/
*.leseg
*.leseg.tmp
/dist

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch space for UI smoke tests and screenshots
.tmp/

# WorkBuddy workspace metadata
.workbuddy/
