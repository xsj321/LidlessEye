# Keep the build context to what the Dockerfile actually copies.
#
# Without this the daemon tars up `.git`, `target/` and the local scratch
# directories on every build: the transfer dominates the build time on a cold
# machine, and anything sitting in the working tree rides along into the
# builder — which is not where untracked files belong.

target/
**/target/

.git/
.gitignore
.gitattributes

# Local state and scratch space
.tmp/
.workbuddy/
lidlesseye-data/
*.leseg
*.leseg.tmp

# The dashboard is built in the Dockerfile's Node stage. Shipping the local
# copy would make the Rust layer depend on whatever was last built on this
# machine — including node_modules with the wrong platform binaries.
web/node_modules
web/.next
web/out
web/dist

# Not needed by the image
docs/
examples/
deploy/
scripts/
.devcontainer/

# Front-end dependencies (the dashboard is committed as plain ES modules)
web/node_modules/
web/src/
